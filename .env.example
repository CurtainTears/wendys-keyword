# Production: set these in your deployment environment, not in the repository.
# Node also supports: node --env-file=.env server.js
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
# Optional: exact IPs/CIDRs of proxies as seen by this app, comma-separated.
# Empty trusts no forwarding headers. Never use client networks or all sources.
TRUSTED_PROXY_CIDRS=
# DATA_DIR=/absolute/path/to/persistent/keyword-data
# Registration always requires an invitation. Issue one on the deployment host:
# First owner only: npm run invite -- create --admin
# Afterwards use the administrator page. Keep the same DATA_DIR and secret.
# BETTER_AUTH_SECRET must be a privately generated random value of at least 32 characters.
# NODE_ENV=production requires an HTTPS APP_ORIGIN and BETTER_AUTH_SECRET.
# Docker Compose requires an HTTPS APP_ORIGIN and BETTER_AUTH_SECRET above.
# KEYWORD_TAG=latest
# Optional invitation purchases. Off preserves the existing invitation/login flow.
ALIPAY_MODE=off
# Sandbox reads the protected project .alipay-sandbox.json. Use separate test data.
# Server-fixed prices: production 990 fen, sandbox-only test 1 fen.
# ALIPAY_MODE=sandbox is forbidden in a NODE_ENV=production process.
# Production: owner mounts a 0600 JSON file OUTSIDE the project/image, then sets:
# ALIPAY_MODE=production
# ALIPAY_PRODUCTION_CONFIG=/run/secrets/alipay-production.json
# Default notification: HTTPS APP_ORIGIN + /api/payments/alipay/notify.
# ALIPAY_NOTIFY_URL=https://your-site.example/api/payments/alipay/notify
# Configuration and opening finite sales inventory are separate steps.
