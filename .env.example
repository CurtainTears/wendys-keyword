# Production: set these in your deployment environment, not in the repository.
# Node also supports: node --env-file=.env server.js
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
# DATA_DIR=/absolute/path/to/persistent/keyword-data
# Registration always requires an invitation. Issue one on the deployment host:
# First owner only: npm run invite -- create --admin
# Afterwards use the administrator page. Keep the same DATA_DIR and secret.
# BETTER_AUTH_SECRET must be a privately generated random value of at least 32 characters.
# NODE_ENV=production requires an HTTPS APP_ORIGIN and BETTER_AUTH_SECRET.
# Docker Compose requires an HTTPS APP_ORIGIN and BETTER_AUTH_SECRET above.
# KEYWORD_TAG=latest
